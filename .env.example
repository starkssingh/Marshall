# Copy to .env (git-ignored) and fill in. Secrets are only ever read from XQ_SECRETS__* variables.

# Configuration profile: dev | research | paper | prod
XQ_PROFILE=research

# Any config key can be overridden as XQ_<SECTION>__<KEY>, for example:
# XQ_LOGGING__LEVEL=DEBUG

# Credentials (leave empty until the broker / data vendor is chosen)
XQ_SECRETS__BROKER_API_KEY=
XQ_SECRETS__DATA_API_KEY=
